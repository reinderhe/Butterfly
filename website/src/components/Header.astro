---
import Search from '@astrojs/starlight/components/Search.astro';
import ThemeSelect from '@astrojs/starlight/components/ThemeSelect.astro';

const links = [
  ['Get started', '/install/'],
  ['Help', '/help/'],
  ['Development', '/progress/'],
  ['About', '/about/'],
];
---
<div class="header">
  <div class="brand">
    <a class="brand-home" href="/" aria-label="Longshot home">
      <img src="/branding/longshot.png" alt="" width="512" height="512" decoding="async" />
      <span>Longshot</span>
    </a>
    <small>by <a href="https://magicbean.dev/">Team MagicBean</a></small>
  </div>
  <nav class="links" aria-label="Main navigation">{links.map(([label, href]) => <a href={href}>{label}</a>)}</nav>
  <details class="mobile-menu">
    <summary>Menu</summary>
    <nav aria-label="Main navigation">{links.map(([label, href]) => <a href={href}>{label}</a>)}</nav>
  </details>
  <div class="tools"><Search /><ThemeSelect /></div>
</div>

<script>
  const menu = document.querySelector<HTMLDetailsElement>('.mobile-menu');
  if (menu) {
    menu.querySelectorAll('a').forEach(link => link.addEventListener('click', () => { menu.open = false; }));
    menu.addEventListener('keydown', event => {
      if (event.key === 'Escape' && menu.open) {
        event.preventDefault();
        event.stopPropagation();
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    });
    document.addEventListener('click', event => {
      if (event.target instanceof Node && !menu.contains(event.target)) menu.open = false;
    });
    window.matchMedia('(max-width: 70rem)').addEventListener('change', () => { menu.open = false; });
  }
</script>

<style>
  .header { height: 100%; display: flex; align-items: center; gap: 2.2rem; }
  .header * { box-sizing: border-box; }

  .brand { display: flex; align-items: center; gap: .5rem; flex-shrink: 0; }
  .brand-home { display: inline-flex; align-items: center; gap: .7rem; color: var(--sl-color-white); text-decoration: none; }
  .brand-home img { display: block; width: 40px; height: 40px; object-fit: contain; }
  .brand-home span { font-family: var(--heading-font); font-weight: 600; font-size: var(--text-xl); line-height: 1; letter-spacing: -.035em; }
  /* On the line of "Longshot": its baseline sits a little below the centre of the logo. */
  .brand small { margin-top: .45rem; font-size: var(--text-label); color: var(--sl-color-gray-2); white-space: nowrap; }
  .brand small a { color: inherit; text-decoration: none; }
  .brand small a:hover { color: var(--sl-color-white); text-decoration: underline; }

  .links { display: flex; align-items: center; gap: 1.6rem; margin-left: auto; }
  .links a { display: inline-flex; align-items: center; min-height: 44px; color: var(--sl-color-gray-1); text-decoration: none; font-weight: 600; }
  .links a:hover { color: var(--sl-color-text-accent); text-decoration: underline; }

  .tools { display: flex; align-items: center; gap: 1.5rem; min-width: 0; }
  .tools :global(button[data-open-modal]) { border: 1px solid var(--border); border-radius: 8px; background: var(--panel); min-height: 44px; }
  .tools :global(select) { font-size: var(--text-xs); min-height: 44px; }
  @media (min-width: 50rem) {
    .tools :global(site-search) { width: 22rem; }
    .tools :global(button[data-open-modal]) { width: 100%; max-width: none; }
  }

  .mobile-menu { display: none; }

  @media (max-width: 70rem) {
    .header { display: grid; grid-template-columns: minmax(0, 1fr) auto; grid-template-rows: auto auto; align-content: center; gap: .15rem .5rem; }
    .links { display: none; }
    .tools { grid-column: 2; grid-row: 1; gap: .75rem; }
    .mobile-menu { display: block; position: relative; grid-row: 2; grid-column: 1 / -1; min-width: 0; }
    .mobile-menu summary { width: fit-content; min-height: 44px; padding: .6rem .8rem; cursor: pointer; font-weight: 600; color: var(--sl-color-white); }
    .mobile-menu nav {
      position: absolute; z-index: 10; inset-inline: 0; top: 100%; display: grid; gap: .2rem; padding: .6rem;
      background: var(--sl-color-bg-nav); border: 1px solid var(--border); border-radius: 8px; box-shadow: 0 12px 24px #0003;
    }
    .mobile-menu nav a { display: block; min-height: 44px; padding: .6rem .8rem; color: var(--sl-color-white); font-weight: 600; text-decoration: none; border-radius: 4px; }
    .mobile-menu nav a:hover { background: var(--panel-hover); text-decoration: underline; }
  }
  @media (max-width: 49.99rem) {
    .brand small { display: none; }
    .brand-home span { font-size: var(--text-xl); }
    .tools :global(select) { max-width: 6rem; }
  }
  @media (max-width: 25rem) {
    .brand-home img { width: 32px; height: 32px; }
    .brand-home span { font-size: var(--text-lg); }
    .tools { gap: .4rem; }
    .tools :global(starlight-theme-select .label-icon) { display: none; }
    .tools :global(starlight-theme-select select) { width: 4.5rem; max-width: none; margin-inline: 0; padding-inline: .25rem 1.4rem; }
  }
</style>
