---
import { AREAS, PLATFORMS, STATUSES } from '../lib/progress.ts';
import ProgressOverview from './ProgressOverview.astro';
const endpoint = '/progress-feed.json';
---
<progress-board class="not-content" data-endpoint={endpoint} data-pagefind-ignore>
  <ProgressOverview />
  <section class="version-watch" aria-labelledby="version-watch-title">
    <p class="progress-eyebrow">WHAT MAY AFFECT YOU</p>
    <h2 id="version-watch-title">Current version watch</h2>
    <div data-watch><p>Loading the latest stable version and its reported problems…</p></div>
    <p class="progress-note">Based on exact versions in report forms. Counts describe reports, not confirmed bugs or affected players. Older reports and unknown versions are kept separate.</p>
  </section>
  <section data-search-panel aria-labelledby="problem-search-title">
  <div class="progress-toolbar">
    <p data-freshness role="status">Loading progress data…</p>
    <button type="button" data-refresh>Check for updates</button>
  </div>
  <p data-warning class="progress-warning" role="status" hidden></p>
  <h2 id="problem-search-title">Search for your problem</h2>
  <p class="progress-note" id="problem-search-help">Describe what went wrong to find similar reports and any reviewed workarounds. You can also browse features, changes and releases below.</p>
  <form role="search" aria-label="Search project progress">
    <label class="progress-search">Search problems, features and updates
      <input id="problem-search" type="search" name="query" aria-describedby="problem-search-help" placeholder="Try “black screen”, “controller” or an issue number" autocomplete="off" />
    </label>
    <fieldset class="progress-views"><legend>Show</legend>
      {[
        ['all', 'Everything'], ['reports', 'Reported problems'], ['features', 'Feature requests'],
        ['changes', 'Changes & work'], ['releases', 'Releases'],
      ].map(([value, label]) => <label><input type="radio" name="view" value={value} checked={value === 'all'} /><span>{label}</span></label>)}
    </fieldset>
    <div class="progress-filters">
      <label>Status<select name="status"><option value="">Any status</option>{Object.entries(STATUSES).map(([value, [label]]) => <option value={value}>{label}</option>)}</select></label>
      <label>Platform<select name="platform"><option value="">Any platform</option>{[...PLATFORMS, 'Unspecified'].map(p => <option>{p}</option>)}</select></label>
      <label>Area<select name="area"><option value="">Any area</option>{[...AREAS, 'Unspecified'].map(a => <option>{a}</option>)}</select></label>
      <label>Reported version<select name="version"><option value="">Any version</option></select></label>
    </div>
    <button type="reset" class="progress-reset">Clear search and filters</button>
  </form>
  <p data-count role="status" aria-live="polite"></p>
  <ul class="progress-results" data-results aria-label="Progress results"></ul>
  <button type="button" data-more hidden>Show more results</button>
  <noscript><p>Enable JavaScript to search and refresh this overview, or use the Forgejo links below.</p></noscript>
  <p class="progress-note">Can’t find it? Search the complete <a href="https://git.magicbean.dev/MagicBeanDev/Longshot/issues">issue tracker</a>, <a href="https://git.magicbean.dev/MagicBeanDev/Longshot/pulls">proposed changes</a> or <a href="https://git.magicbean.dev/MagicBeanDev/Longshot/releases">release history</a>.</p>
  </section>
</progress-board>

<script>
  import { ProgressBoard } from '../lib/progress-board';
  if (!customElements.get('progress-board')) customElements.define('progress-board', ProgressBoard);
</script>

<style is:global>
  progress-board { display: block; }
  progress-board [hidden] { display: none !important; }
  progress-board h2, progress-board h3 { font-family: var(--heading-font); font-weight: 600; line-height: 1.3; }
  progress-board p { margin: .65rem 0; }
  progress-board a { color: var(--sl-color-text-accent); overflow-wrap: anywhere; }
  .version-watch { padding: 1.4rem; margin: 1.5rem 0; background: var(--panel); border: 1px solid var(--border); border-radius: .6rem; }
  .version-watch h2 { margin: .4rem 0 1rem; font-size: var(--text-xl); }
  .progress-eyebrow { color: var(--sl-color-text-accent); font-size: var(--text-label); letter-spacing: .08em; font-weight: 700; }
  .progress-note { font-size: var(--text-xs); color: var(--sl-color-gray-2); }
  .progress-toolbar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .5rem 1rem; }
  .progress-toolbar p { flex: 1 1 15rem; font-size: var(--text-xs); }
  progress-board button, progress-board input, progress-board select { font: inherit; }
  progress-board button { cursor: pointer; color: var(--sl-color-white); background: var(--panel); border: 1px solid var(--sl-color-gray-3); border-radius: .3rem; padding: .55rem .8rem; min-height: 44px; }
  progress-board button:hover { background: var(--panel-hover); }
  progress-board button:disabled { cursor: wait; opacity: .7; }
  progress-board :is(button, input, select, summary, a):focus-visible { outline: 2px solid var(--sl-color-text-accent); outline-offset: 3px; }
  .progress-warning { border-left: 3px solid var(--sl-color-text-accent); padding: .75rem 1rem; background: var(--panel); }
  .progress-search { display: grid; gap: .4rem; margin-top: 1.4rem; font-weight: 700; }
  #problem-search { scroll-margin-top: calc(var(--sl-nav-height) + 1rem); }
  progress-board input[type='search'], progress-board select { min-width: 0; width: 100%; color: var(--sl-color-white); background: var(--sl-color-bg); border: 1px solid var(--sl-color-gray-3); border-radius: .3rem; padding: .65rem; min-height: 44px; font-weight: 400; }
  .progress-views { border: 0; padding: 0; margin: 1rem 0; display: flex; flex-wrap: wrap; gap: .5rem; }
  .progress-views legend { margin-bottom: .4rem; }
  .progress-views label { position: relative; cursor: pointer; }
  .progress-views input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .progress-views span { display: block; border: 1px solid var(--sl-color-gray-3); border-radius: .3rem; padding: .5rem .7rem; min-height: 44px; }
  .progress-views input:checked + span { background: var(--sl-color-accent-low); border-color: var(--sl-color-text-accent); color: var(--sl-color-accent-high); font-weight: 700; }
  .progress-views input:focus-visible + span { outline: 2px solid var(--sl-color-text-accent); outline-offset: 3px; }
  .progress-filters { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .8rem; }
  .progress-filters label { display: grid; gap: .3rem; }
  .progress-reset { margin-top: 1rem; }
  .progress-results { list-style: none; padding: 0; display: grid; gap: 1rem; }
  .progress-card { padding: 1.2rem; border: 1px solid var(--border); border-radius: .5rem; background: var(--panel); overflow-wrap: anywhere; }
  .progress-card h3 { font-size: var(--text-lg); margin: .7rem 0; }
  .progress-card h3 a { text-decoration-thickness: 1px; }
  .progress-card .progress-meta { font-size: var(--text-xs); color: var(--sl-color-gray-2); }
  .progress-status { display: inline-block; border: 1px solid var(--sl-color-gray-3); padding: .15rem .5rem; border-radius: .25rem; font-size: var(--text-label); color: var(--sl-color-accent-high); }
  .progress-card details { margin-top: .75rem; }
  .progress-card summary { cursor: pointer; color: var(--sl-color-text-accent); }
  .progress-card details p { font-size: var(--text-xs); }
  .watch-groups { padding-left: 1.3rem; }
  .watch-groups li { margin: .6rem 0; }
  .watch-groups summary { cursor: pointer; }
  @media (max-width: 30rem) { .progress-filters { grid-template-columns: 1fr; } .version-watch, .progress-card { padding: 1rem; } }
</style>
