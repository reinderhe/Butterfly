// The Worker serving longshot.magicbean.dev: the built site (dist/), with worker/index.ts answering /download (the
// Longshot Launcher's permanent download links). Deployed from main by .forgejo/workflows/website.yml; a pull request's
// preview uploads a version without deploying it.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "longshot-website",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-11",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/download", "/download/*"]
  },
  "workers_dev": false,
  "preview_urls": true,
  "routes": [{ "pattern": "longshot.magicbean.dev", "custom_domain": true }]
}
